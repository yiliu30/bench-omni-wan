# Wan2.2 T2V Benchmark - MXAttention smoke test
# Default denoising steps with a smaller frame count.

# --- Server ---
MODEL=/dev/shm/.tmp_yi/models/Wan-AI/Wan2.2-T2V-A14B-Diffusers/
PYTHON=/dev/shm/.tmp_yi/workspace/omni-wan/.venv/bin/python
VLLM_OMNI_ROOT=/dev/shm/.tmp_yi/workspace/omni-wan
HOST=127.0.0.1
PORT=8099
TP=2
CUDA_DEVICES=0,1
ENFORCE_EAGER=false
ENABLE_CPU_OFFLOAD=false
EXTRA_SERVE_ARGS=

# --- Benchmark ---
TASK=t2v
BACKEND=v1/videos
DATASET=vbench
NUM_PROMPTS=1
MAX_CONCURRENCY=1
WIDTH=640
HEIGHT=480
NUM_FRAMES=33
FPS=16
NUM_INFERENCE_STEPS=40
SEED=42
ENABLE_NEGATIVE_PROMPT=false
OUTPUT_DIR=./output/bench_mxattention_smoke

# --- Environment Variables (exported to server subprocess) ---
[env]
# VLLM_LOGGING_LEVEL=DEBUG
# PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True
