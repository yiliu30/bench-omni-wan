# Wan2.2 T2V Benchmark - Default Configuration
# One env file per benchmark configuration. The runner reads this file.

# --- Server ---
# MODEL=/media/hf_models/Wan2.2-T2V-A14B-Diffusers
# PYTHON=/home/yiliu7/workspace/venvs/omni/bin/python
# VLLM_OMNI_ROOT=/home/yiliu7/workspace/vllm-omni
MODEL=/storage/yiliu7/Wan-AI/Wan2.2-T2V-A14B-Diffusers
PYTHON=/home/yiliu7/workspace/venvs/omni/bin/python
VLLM_OMNI_ROOT=/home/yiliu7/workspace/vllm-omni
HOST=127.0.0.1
PORT=8097
TP=2
CUDA_DEVICES=2,3
ENFORCE_EAGER=false
ENABLE_CPU_OFFLOAD=false
# Extra vllm serve flags (space-separated, e.g. "--use-hsdp --usp 2")
# EXTRA_SERVE_ARGS=--quantization mxfp8

# --- Benchmark ---
TASK=t2v
BACKEND=v1/videos
DATASET=vbench
NUM_PROMPTS=10
MAX_CONCURRENCY=1
WIDTH=1280
HEIGHT=720
NUM_FRAMES=81
FPS=16
NUM_INFERENCE_STEPS=40
SEED=42
ENABLE_NEGATIVE_PROMPT=false
OUTPUT_DIR=/home/yiliu7/workspace/wan-res/default_mxfp4_hw_rotation_attn_only

# --- Environment Variables (exported to server subprocess) ---
[env]
# VLLM_LOGGING_LEVEL=DEBUG
# PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True
VLLM_SAGE3_TRITON=1
DIFFUSION_ATTENTION_BACKEND=SAGE_ATTN
SAGE3_QUANT_FORMAT=mxfp4_hw_rotation
# SAGE3_ACC_DTYPE=bf16_both_dot