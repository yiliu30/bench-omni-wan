# Wan2.2 T2V Benchmark - Smoke Test
# Small resolution, few steps, fast iteration.

# --- Server ---
MODEL=/media/hf_models/Wan2.2-T2V-A14B-Diffusers
PYTHON=/home/yiliu7/workspace/venvs/omni/bin/python
VLLM_OMNI_ROOT=/home/yiliu7/workspace/vllm-omni
HOST=127.0.0.1
PORT=8099
TP=2
CUDA_DEVICES=0,1
ENFORCE_EAGER=false
ENABLE_CPU_OFFLOAD=false
EXTRA_SERVE_ARGS=

# --- Benchmark ---
TASK=t2v
BACKEND=v1/videos
DATASET=vbench
NUM_PROMPTS=2
MAX_CONCURRENCY=1
WIDTH=640
HEIGHT=480
NUM_FRAMES=33
FPS=16
NUM_INFERENCE_STEPS=4
SEED=42
ENABLE_NEGATIVE_PROMPT=false
