# Wan2.2 T2V Benchmark - Eager Mode
# CUDA graphs disabled, useful for profiling and debugging.

# --- Server ---
MODEL=/media/hf_models/Wan2.2-T2V-A14B-Diffusers
PYTHON=/home/yiliu7/workspace/venvs/omni/bin/python
VLLM_OMNI_ROOT=/home/yiliu7/workspace/vllm-omni
HOST=127.0.0.1
PORT=8099
TP=2
CUDA_DEVICES=0,1
ENFORCE_EAGER=true
ENABLE_CPU_OFFLOAD=false
EXTRA_SERVE_ARGS=

# --- Benchmark ---
TASK=t2v
BACKEND=v1/videos
DATASET=vbench
NUM_PROMPTS=5
MAX_CONCURRENCY=1
WIDTH=1280
HEIGHT=720
NUM_FRAMES=81
FPS=16
NUM_INFERENCE_STEPS=40
SEED=42
ENABLE_NEGATIVE_PROMPT=false
