# Wan2.2 T2V — MXAttention full, complete 72-prompt VBench run.
# The runner launches four TP1 shards on physical GPUs 1,2,3,5 and reuses
# existing videos in output/mxattention_full_common10/videos.

# --- Server ---
MODEL=/dev/shm/.tmp_yi/models/Wan-AI/Wan2.2-T2V-A14B-Diffusers
PYTHON=/dev/shm/.tmp_yi/workspace/omni-wan/.venv/bin/python
VLLM_OMNI_ROOT=/dev/shm/.tmp_yi/workspace/omni-wan
HOST=127.0.0.1
PORT=8102
TP=1
CUDA_DEVICES=1
ENFORCE_EAGER=false
ENABLE_CPU_OFFLOAD=false
EXTRA_SERVE_ARGS=

# --- Generation ---
TASK=t2v
BACKEND=v1/videos
DATASET=vbench
NUM_PROMPTS=72
MAX_CONCURRENCY=1
WIDTH=1280
HEIGHT=720
NUM_FRAMES=81
FPS=16
NUM_INFERENCE_STEPS=40
SEED=42
ENABLE_NEGATIVE_PROMPT=false
OUTPUT_DIR=output/mxattention_full_common10/videos

# --- Environment variables exported to each server ---
[env]
VLLM_MXATTENTION=1
MXATTENTION_MODE=mxattention_full
MXATTENTION_QMAX=7.25
MXATTENTION_USE_HADAMARD=1
DIFFUSION_ATTENTION_BACKEND=SAGE_ATTN
