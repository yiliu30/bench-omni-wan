# Wan2.2 T2V on Intel XPU 1 - Sage V3 Hybrid (newbuild kernel) with selective
# SDPA fallback on blocks 33,34,38,39 + MXFP8 linear + cache-dit.
# VBench dense93 campaign recipe (matches the offline dense runner):
# 720x1280 @16fps, 81 frames, 40 steps, guidance 4.0/3.0, boundary 0.875,
# flow shift 5.0, seed 42, negative prompt.

# --- Server ---
MODEL=/workspace/hf_models/Wan2.2-T2V-A14B-Diffusers
PYTHON=/opt/gfx-deps/venv/bin/python3
VLLM_OMNI_ROOT=/workspace/vllm-omni-inner
HOST=127.0.0.1
PORT=8099
TP=1
ENFORCE_EAGER=false
ENABLE_CPU_OFFLOAD=false
EXTRA_SERVE_ARGS=--quantization mxfp8 --cache-backend cache_dit --enable-cache-dit-summary --boundary-ratio 0.875 --flow-shift 5.0

# --- Benchmark / generation ---
TASK=t2v
BACKEND=v1/videos
DATASET=vbench
MAX_CONCURRENCY=1
WIDTH=1280
HEIGHT=720
NUM_FRAMES=81
FPS=16
NUM_INFERENCE_STEPS=40
SEED=42
OUTPUT_DIR=/workspace/tmp_yi_yiwan/vbench_dense93

# Per-request /v1/videos fields: dual-stage guidance (low/high) + negative
# prompt, matching the offline dense recipe.
EXTRA_VIDEO_FIELDS_JSON={"guidance_scale": "4.0", "guidance_scale_2": "3.0", "negative_prompt": "色调艳丽，过曝，静态，细节模糊不清，字幕，风格，作品，画作，画面，静止，整体发灰，最差质量，低质量，JPEG压缩残留，丑陋的，残缺的，多余的手指，画得不好的手部，画得不好的脸部，畸形的，毁容的，形态畸形的肢体，手指融合，静止不动的画面，杂乱的背景，三条腿，背景人很多，倒着走", "boundary_ratio": "0.875"}

# --- Environment Variables (exported to server subprocess) ---
[env]
ZE_FLAT_DEVICE_HIERARCHY=FLAT
ZE_AFFINITY_MASK=1
PYTHONPATH=/workspace/deepklox-sage3-compat:/workspace/deepklox-sage3
DIFFUSION_ATTENTION_BACKEND=SAGE_ATTN_3
SAGE_ATTN_FORCE_SDPA_BLOCKS=33,34,38,39
DEEPKLOX_SAGEATTN_HYBRID_FUSED_PREP=1
SAGE_ATTN_XPU_LAYOUT=auto
SAGE_ATTN_REPORT_FALLBACKS=1
VLLM_WORKER_MULTIPROC_METHOD=spawn
