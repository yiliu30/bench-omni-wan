# Wan2.2 T2V bf16 + cache-dit BASELINE (NVIDIA B300 node, GPU 3).
# VBench dense93 recipe, bf16 weights (no --quantization) + cache-dit:
# 720x1280 @16fps, 81 frames, 40 steps, guidance 4.0/3.0, boundary 0.875,
# flow shift 5.0, seed 42, negative prompt.

MODEL=/models/Wan2.2-T2V-A14B-Diffusers
PYTHON=/models/yiliu7/envs/omni-bf16/bin/python
VLLM_OMNI_ROOT=/models/yiliu7/vllm-omni-baseline
HOST=127.0.0.1
PORT=8091
TP=1
CUDA_DEVICES=3
ENFORCE_EAGER=false
ENABLE_CPU_OFFLOAD=false
EXTRA_SERVE_ARGS=--cache-backend cache_dit --enable-cache-dit-summary --boundary-ratio 0.875 --flow-shift 5.0
TASK=t2v
BACKEND=v1/videos
DATASET=vbench
MAX_CONCURRENCY=1
WIDTH=1280
HEIGHT=720
NUM_FRAMES=5
FPS=16
NUM_INFERENCE_STEPS=4
SEED=42
OUTPUT_DIR=/models/yiliu7/wan-res/bf16_cachedit_dense93/smoke_gpu3
EXTRA_VIDEO_FIELDS_JSON={"guidance_scale": "4.0", "guidance_scale_2": "3.0", "negative_prompt": "色调艳丽，过曝，静态，细节模糊不清，字幕，风格，作品，画作，画面，静止，整体发灰，最差质量，低质量，JPEG压缩残留，丑陋的，残缺的，多余的手指，画得不好的手部，画得不好的脸部，畸形的，毁容的，形态畸形的肢体，手指融合，静止不动的画面，杂乱的背景，三条腿，背景人很多，倒着走", "boundary_ratio": "0.875"}
