# Wan2.2 T2V on Intel XPU 4 (yi-wan container, THIS box) - Sage V3 Hybrid
# (deepklox-sparse) + fallback blocks 0,33,34,38 + MXFP8 linear + cache-dit.
# DEFAULT FRAMES CONFIG (1280x720, 81f@16fps, 40 steps, seed 42) WITHOUT the
# negative prompt: guidance stays 4.0/3.0, so CFG runs against the server
# default (empty-string) negative embeddings. Ablation arm vs
# xpu_sagev3_mxfp8_cachedit_fb0333438_xpu4.env (which carries the 137-char
# Chinese negative). For run.py, ENABLE_NEGATIVE_PROMPT=false keeps the bench
# client negative-free too.

# --- Server ---
MODEL=/mnt/hostroot/mnt/disk3/home/chendixu/hf_models/Wan2.2-T2V-A14B-Diffusers
PYTHON=/opt/gfx-deps/venv/bin/python3
VLLM_OMNI_ROOT=/home/yiliu7/vllm-omni-bsa
HOST=127.0.0.1
PORT=8104
TP=1
ENFORCE_EAGER=false
ENABLE_CPU_OFFLOAD=false
EXTRA_SERVE_ARGS=--quantization mxfp8 --cache-backend cache_dit --enable-cache-dit-summary --boundary-ratio 0.875 --flow-shift 5.0

# --- Benchmark / generation (default frames config) ---
TASK=t2v
BACKEND=v1/videos
DATASET=vbench
NUM_PROMPTS=5
MAX_CONCURRENCY=1
WIDTH=1280
HEIGHT=720
NUM_FRAMES=81
FPS=16
NUM_INFERENCE_STEPS=40
SEED=42
ENABLE_NEGATIVE_PROMPT=false
OUTPUT_DIR=/home/yiliu7/bench-omni-wan/results/fb0333438_noneg_xpu4

# Per-request fields: dual-stage guidance + boundary, NO negative_prompt.
EXTRA_VIDEO_FIELDS_JSON={"guidance_scale": "4.0", "guidance_scale_2": "3.0", "boundary_ratio": "0.875"}

# --- Environment Variables (exported to server subprocess) ---
[env]
ZE_FLAT_DEVICE_HIERARCHY=FLAT
ZE_AFFINITY_MASK=4
PYTHONPATH=/home/yiliu7/vllm-omni-bsa/aaawork/pyshims:/home/yiliu7/vllm-omni-bsa:/home/yiliu7/deepklox-sparse
DIFFUSION_ATTENTION_BACKEND=SAGE_ATTN_3
SAGE_ATTN_FORCE_SDPA_BLOCKS=0,33,34,38
DEEPKLOX_SAGEATTN_HYBRID_FUSED_PREP=1
SAGE_ATTN_XPU_LAYOUT=auto
SAGE_ATTN_REPORT_FALLBACKS=1
VLLM_WORKER_MULTIPROC_METHOD=spawn
